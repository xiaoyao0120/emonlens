# ---- Java / Maven ----
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.flattened-pom.xml

# ---- IDE / OS ----
.idea/
*.iml
.vscode/
.DS_Store

# ---- 日志 / 环境 ----
logs/
*.log
.env

# ---- 前端 ----
node_modules/
emonlens-ui/dist/
# 内嵌 UI 为构建产物（make ui / Docker ui 阶段重新生成），不入库
emonlens-server/src/main/resources/static/

# ---- Python SDK ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
emonlens-sdk-python/build/
emonlens-sdk-python/dist/
emonlens-sdk-python/.pytest_cache/
emonlens-sdk-python/.venv/

# ---- 工作目录残留 ----
/emonlens-server-*.jar
artifacts/
.orchelon
design
emonlens-ui/.impeccable

# 内部设计/验收文档与 AWR 台账：遵循 CONTRIBUTING「设计文档由维护者内部同步（不随本仓库发布）」，
# 只发布操作类文档（部署/接入/日常操作），这些内容仅保留在本地
/design/
/test/
work-ledger.yaml

# AWR 全部为本地运行时状态（state.db、锁文件、验收报告、content review 回执等）：
# 一律不入库，避免把机器本地状态与每次校验产物提交到远端
.awr/
# 台账重建时移开的旧状态（仅本地留证）
.awr.broken-*/
# 临时产物（日志/构建输出）：统一写到项目外的 tmp 目录（D:\tmp\emonlens），万一落下也不入库
/.tmp*
